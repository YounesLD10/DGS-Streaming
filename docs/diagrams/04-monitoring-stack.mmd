%%{init: {'theme': 'neutral'}}%%
flowchart TB
    subgraph TARGETS["Scrape targets"]
        JM["flink-jobmanager :9249\n(static target)"]
        TM["flink-taskmanager :9249\n(kubernetes_sd_configs pod discovery\n+ RBAC + relabel on component=taskmanager)"]
        MN["MinIO\n/minio/v2/metrics/cluster"]
        EXP["hps_exporter.py — :8888/metrics\n(custom Python HTTPServer)"]
    end

    subgraph EXP_INTERNALS["Business metrics exporter internals"]
        EK["Kafka consumer\n→ hps_payments_total{stage,topic}"]
        EM["MinIO client\n→ hps_minio_objects{layer}"]
        EP["Postgres query\n→ hps_datamart_total\n→ hps_risk_score_total{risk}\n→ hps_payment_channel_total{channel}"]
        EK & EM & EP --> EXP
    end

    PROM["Prometheus\n(prometheus-config ConfigMap\nscrape_configs)"]

    subgraph DASH["Grafana — dashboard 'HPS Streaming Pipeline' (7 panels)"]
