        ROW2["Stat: Bronze / Silver / Gold object counts"]
        ROW3["Timeseries: Pipeline Stage Flow\n(5 series — hps_payments_total per stage)"]
    end

    JM --> PROM
    TM --> PROM
    MN --> PROM
    EXP --> PROM
    PROM -- "PromQL" --> ROW1
    PROM -- "PromQL" --> ROW2
    PROM -- "PromQL" --> ROW3

